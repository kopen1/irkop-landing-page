@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
.changelog {
  white-space: pre-line;
}

.changelog {
  white-space: pre-wrap;
}

:root {
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #111b36;
  background: #f7f8fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --navy: #101a33;
  --navy-2: #172342;
  --purple: #6d35e8;
  --purple-2: #8b5cf6;
  --blue: #2563eb;
  --text: #111b36;
  --muted: #667085;
  --line: #e4e7ef;
  --surface: #ffffff;
  --soft: #f5f6fb;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 78px;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 10% 30%, rgba(109, 53, 232, 0.035), transparent 30%),
    #f7f8fc;
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-shell {
  min-height: 100vh;
  overflow-x: hidden;
}

/* =========================================================
   NAVBAR
   ========================================================= */

.irkop-navbar {
  position: sticky !important;
  position: -webkit-sticky !important;
  top: 0 !important;
  z-index: 9999;
  width: 100%;
  background: rgba(10, 18, 37, 0.94);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.nav-inner {
  width: min(1180px, calc(100% - 40px));
  height: 70px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 28px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: white;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.ir-logo {
  display: inline-flex;
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
}

.ir-logo-small {
  width: 30px;
  height: 30px;
}

.ir-logo svg {
  width: 100%;
  height: 100%;
}

.desktop-nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 26px;
}

.desktop-nav a {
  color: rgba(255, 255, 255, 0.76);
  font-size: 13px;
  font-weight: 500;
  transition: color 180ms ease;
}

.desktop-nav a:hover {
  color: white;
}

.nav-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 15px;
  border-radius: 9px;
  background: linear-gradient(135deg, #7c3aed, #5b21b6);
  color: white;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 8px 25px rgba(109, 53, 232, 0.28);
}

.mobile-toggle {
  display: none;
  border: 0;
  background: transparent;
  color: white;
}

/* =========================================================
   HERO
   ========================================================= */

.hero-section {
  position: relative;
  min-height: 590px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 75% 50%, rgba(100, 66, 220, 0.30), transparent 31%),
    radial-gradient(circle at 92% 10%, rgba(37, 99, 235, 0.22), transparent 28%),
    linear-gradient(135deg, #0d162b 0%, #111c37 52%, #14234a 100%);
  color: white;
  isolation: isolate;
  cursor: pointer;
}

.hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.24;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to right, transparent, black 35%, black 85%, transparent);
}

.hero-glow {
  position: absolute;
  border-radius: 999px;
  filter: blur(60px);
  pointer-events: none;
}

.hero-glow-one {
  width: 270px;
  height: 270px;
  right: 27%;
  top: 20%;
  background: rgba(124, 58, 237, 0.18);
}

.hero-glow-two {
  width: 190px;
  height: 190px;
  right: 8%;
  bottom: 5%;
  background: rgba(37, 99, 235, 0.16);
}

.hero-section.hero-active {
  animation: heroClick 700ms ease-out;
}

.hero-section.hero-active::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(
    circle at 68% 50%,
    rgba(139, 92, 246, 0.25),
    transparent 42%
  );
  animation: heroFlash 700ms ease-out;
}

@keyframes heroClick {
  0% { transform: scale(1); }
  20% { transform: scale(1.006); }
  100% { transform: scale(1); }
}

@keyframes heroFlash {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 0; }
}

.container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.hero-inner {
  position: relative;
  z-index: 2;
  min-height: 590px;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  align-items: center;
  gap: 20px;
}

.hero-copy {
  padding: 65px 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  padding: 7px 11px;
  border: 1px solid rgba(139, 92, 246, 0.34);
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.10);
  color: #c4b5fd;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.eyebrow-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 0 12px #8b5cf6;
}

.hero-copy h1 {
  max-width: 650px;
  margin: 0;
  font-size: clamp(42px, 5.2vw, 72px);
  line-height: 0.98;
  letter-spacing: -0.055em;
  font-weight: 800;
}

.hero-copy p {
  max-width: 560px;
  margin: 24px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 16px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 30px;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 45px;
  padding: 0 17px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
}

.primary-button {
  background: linear-gradient(135deg, #8b5cf6, #5b21b6);
  color: white;
  box-shadow: 0 12px 32px rgba(109, 53, 232, 0.34);
}

.secondary-button {
  color: rgba(255,255,255,.8);
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.035);
}

.hero-trust {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 38px;
}

.trust-icons {
  display: flex;
}

.trust-icons span {
  width: 28px;
  height: 28px;
  margin-right: -5px;
  display: grid;
  place-items: center;
  border: 2px solid #101a33;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5cf6, #2563eb);
}

.hero-trust strong,
.hero-trust small {
  display: block;
}

.hero-trust strong {
  font-size: 11px;
}

.hero-trust small {
  margin-top: 2px;
  color: rgba(255,255,255,.46);
  font-size: 10px;
}

/* =========================================================
   DEVICE VISUAL
   ========================================================= */

.device-stage {
  position: relative;
  height: 500px;
  perspective: 1000px;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
  opacity: .75;
}

.orb-one {
  width: 290px;
  height: 290px;
  right: 80px;
  top: 85px;
  background: radial-gradient(circle, rgba(124,58,237,.34), transparent 68%);
}

.orb-two {
  width: 230px;
  height: 230px;
  right: 0;
  bottom: 20px;
  background: radial-gradient(circle, rgba(37,99,235,.25), transparent 68%);
}

.device-back-card {
  position: absolute;
  border: 1px solid rgba(255,255,255,.13);
  background: rgba(255,255,255,.055);
  box-shadow: 0 25px 70px rgba(0,0,0,.25);
  backdrop-filter: blur(8px);
}

.device-back-one {
  width: 240px;
  height: 165px;
  right: 65px;
  top: 80px;
  border-radius: 20px;
  transform: rotate(-9deg);
}

.device-back-two {
  width: 150px;
  height: 150px;
  right: 345px;
  top: 110px;
  border-radius: 50%;
  transform: rotate(9deg);
  display: grid;
  place-items: center;
}

.floating-symbol {
  font-size: 42px;
  color: #a78bfa;
  text-shadow: 0 0 30px rgba(167,139,250,.7);
}

.mini-window {
  padding: 17px;
}

.mini-dots {
  display: flex;
  gap: 5px;
}

.mini-dots i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255,255,255,.35);
}

.mini-lines {
  margin-top: 18px;
  display: grid;
  gap: 11px;
}

.mini-lines span {
  display: block;
  height: 9px;
  border-radius: 5px;
  background: rgba(255,255,255,.10);
}

.mini-lines span:nth-child(2) {
  width: 72%;
}

.mini-lines span:nth-child(3) {
  width: 48%;
}

.phone {
  position: absolute;
  z-index: 5;
  right: 145px;
  top: 62px;
  width: 205px;
  height: 390px;
  padding: 8px;
  border: 3px solid #273657;
  border-radius: 31px;
  background: #080f20;
  box-shadow:
    0 40px 80px rgba(0,0,0,.42),
    0 0 45px rgba(124,58,237,.18);
  transform: rotate(7deg);
}

.phone-top {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 9px;
  width: 74px;
  height: 19px;
  transform: translateX(-50%);
  border-radius: 0 0 12px 12px;
  background: #080f20;
}

.phone-top span {
  position: absolute;
  left: 50%;
  top: 6px;
  width: 25px;
  height: 4px;
  transform: translateX(-50%);
  border-radius: 10px;
  background: #28334e;
}

.phone-screen {
  height: 100%;
  padding: 28px 12px 13px;
  overflow: hidden;
  border-radius: 23px;
  background:
    radial-gradient(circle at 80% 15%, rgba(124,58,237,.28), transparent 35%),
    linear-gradient(160deg, #182444, #0d1528);
}

.screen-header {
  display: flex;
  align-items: center;
  gap: 6px;
  color: white;
  font-size: 9px;
  font-weight: 800;
}

.screen-header .ir-logo-small {
  width: 19px;
  height: 19px;
}

.screen-title {
  margin-top: 30px;
  color: white;
  font-size: 25px;
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -.05em;
}

.screen-card {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 17px;
  padding: 8px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  background: rgba(255,255,255,.055);
}

.screen-card .app-icon {
  width: 31px;
  height: 31px;
  border-radius: 8px;
  font-size: 7px;
}

.screen-card strong,
.screen-card small {
  display: block;
}

.screen-card strong {
  color: white;
  font-size: 8px;
}

.screen-card small {
  margin-top: 3px;
  color: rgba(255,255,255,.42);
  font-size: 6px;
}

.screen-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
  color: #a78bfa;
  font-size: 7px;
  font-weight: 700;
}

.tablet {
  position: absolute;
  z-index: 3;
  right: 305px;
  bottom: 48px;
  width: 255px;
  height: 185px;
  padding: 7px;
  border: 2px solid #273657;
  border-radius: 18px;
  background: #0a1123;
  box-shadow: 0 35px 65px rgba(0,0,0,.38);
  transform: rotate(-7deg);
}

.tablet-screen {
  height: 100%;
  padding: 14px;
  border-radius: 12px;
  background: linear-gradient(135deg, #192645, #10192e);
}

.tablet-header {
  display: flex;
  justify-content: space-between;
  color: rgba(255,255,255,.62);
  font-size: 7px;
  font-weight: 700;
}

.tablet-heading {
  margin-top: 18px;
  color: white;
  font-size: 21px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -.05em;
}

.tablet-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 7px;
  margin-top: 17px;
}

.tablet-grid div {
  padding: 7px 3px;
  border-radius: 8px;
  background: rgba(255,255,255,.05);
  text-align: center;
}

.tablet-grid .app-icon {
  width: 25px;
  height: 25px;
  margin: 0 auto 4px;
  border-radius: 6px;
  font-size: 6px;
}

.tablet-grid b {
  display: block;
  color: rgba(255,255,255,.7);
  font-size: 6px;
}

.floating-card {
  position: absolute;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 12px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  background: rgba(20,31,59,.8);
  color: white;
  font-size: 9px;
  font-weight: 700;
  box-shadow: 0 15px 35px rgba(0,0,0,.25);
  backdrop-filter: blur(12px);
}

.floating-card-top {
  top: 75px;
  right: 15px;
  color: #c4b5fd;
}

.floating-card-bottom {
  bottom: 65px;
  right: 80px;
  color: #86efac;
}

/* =========================================================
   CONTENT
   ========================================================= */

.content-section {
  padding: 88px 0;
}

.apps-section {
  background: #ffffff;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 30px;
}

.section-kicker {
  display: block;
  margin-bottom: 8px;
  color: #6d35e8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.section-kicker.light {
  color: #c4b5fd;
}

.section-heading h2,
.about-copy h2,
.download-copy h2 {
  margin: 0;
  color: var(--text);
  font-size: clamp(30px, 4vw, 44px);
  line-height: 1.05;
  letter-spacing: -.045em;
}

.section-heading p {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: #5b21b6;
  font-size: 12px;
  font-weight: 700;
}

.app-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.app-card {
  min-height: 245px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: white;
  box-shadow: 0 10px 35px rgba(16, 24, 40, .035);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease;
}

.app-card:hover {
  transform: translateY(-5px);
  border-color: rgba(109,53,232,.20);
  box-shadow: 0 20px 45px rgba(16,24,40,.09);
}

.app-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.app-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: white;
  font-size: 12px;
  font-weight: 800;
  box-shadow: 0 9px 20px rgba(16,24,40,.13);
}

.app-icon-0 {
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
}

.app-icon-1 {
  background: linear-gradient(135deg, #10b981, #059669);
}

.app-icon-2 {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.app-icon-3 {
  background: linear-gradient(135deg, #f59e0b, #ea580c);
}

.version-badge {
  padding: 5px 8px;
  border-radius: 999px;
  background: #f1edff;
  color: #5b21b6;
  font-size: 9px;
  font-weight: 800;
}

.app-card h3 {
  margin: 18px 0 7px;
  color: var(--text);
  font-size: 17px;
}

.app-card > p {
  min-height: 42px;
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.65;
}

.app-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 21px;
  padding-top: 14px;
  border-top: 1px solid #eef0f5;
}

.app-card-footer > span:first-child {
  overflow: hidden;
  color: #98a2b3;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 8px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.small-download {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 9px;
  border: 1px solid #d9d1f8;
  border-radius: 7px;
  background: white;
  color: #5b21b6;
  font-size: 9px;
  font-weight: 700;
}

.details-label {
  color: #98a2b3 !important;
  font-size: 9px !important;
}

.skeleton-card {
  height: 245px;
  min-height: 0;
  animation: skeleton 1.2s ease-in-out infinite alternate;
}

@keyframes skeleton {
  from { opacity: .45; }
  to { opacity: .9; }
}

.empty-card {
  padding: 45px;
  border: 1px dashed #d9dce5;
  border-radius: 12px;
  color: #667085;
  text-align: center;
}

/* =========================================================
   STATS
   ========================================================= */

.stats-strip {
  position: relative;
  z-index: 3;
  margin: -1px auto 0;
  background: linear-gradient(90deg, #f2efff, #f7f4ff, #eef2ff);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  min-height: 108px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1px solid rgba(109,53,232,.10);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-item strong {
  color: #5424cf;
  font-size: 28px;
  letter-spacing: -.04em;
}

.stat-item span {
  margin-top: 2px;
  color: #4d5669;
  font-size: 9px;
  font-weight: 600;
}

/* =========================================================
   ABOUT
   ========================================================= */

.about-section {
  background: #f7f8fc;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.about-visual {
  min-height: 380px;
  display: grid;
  place-items: center;
}

.about-panel {
  width: min(100%, 480px);
  padding: 22px;
  border: 1px solid #dfe3ec;
  border-radius: 17px;
  background: white;
  box-shadow: 0 25px 60px rgba(16,24,40,.08);
}

.about-panel-header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding-bottom: 17px;
  border-bottom: 1px solid #eef0f5;
}

.about-panel-header strong,
.about-panel-header span {
  display: block;
}

.about-panel-header strong {
  color: var(--text);
  font-size: 12px;
}

.about-panel-header span {
  margin-top: 3px;
  color: #98a2b3;
  font-size: 9px;
}

.about-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 35px 0;
}

.flow-node {
  width: 88px;
  min-height: 75px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid #e1e4ec;
  border-radius: 11px;
  background: #fafbfc;
  color: #667085;
  font-size: 9px;
  font-weight: 700;
}

.flow-node.active {
  border-color: #d7cdf8;
  background: #f5f1ff;
  color: #5b21b6;
  box-shadow: 0 10px 25px rgba(109,53,232,.10);
}

.flow-line {
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, #c4b5fd, #60a5fa);
}

.supabase-mark {
  color: #10b981;
  font-size: 21px;
}

.about-checks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.about-checks span {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #475467;
  font-size: 10px;
}

.about-checks svg {
  color: #10b981;
}

.about-copy > p {
  max-width: 560px;
  margin: 20px 0 30px;
  color: #667085;
  font-size: 14px;
  line-height: 1.8;
}

.feature-list {
  display: grid;
  gap: 18px;
}

.feature-list > div {
  display: flex;
  gap: 13px;
}

.feature-number {
  color: #8b5cf6;
  font-size: 10px;
  font-weight: 800;
}

.feature-list strong {
  color: var(--text);
  font-size: 12px;
}

