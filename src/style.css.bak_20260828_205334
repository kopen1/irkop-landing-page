/* =========================================================
   ELEKTRIC FLOW - Gaya listrik untuk About (diperbaiki)
   ========================================================= */

.electric-flow {
  position: relative;
  margin: 12px auto 8px;
  padding: 6px 0;
  min-height: 160px; /* tambahkan tinggi minimum */
  overflow: visible; /* biar tidak terpotong */
}

/* Perbesar flow agar terlihat jelas */
.electric-flow .irkop-flow {
  transform: scale(0.9) !important; /* diperbesar dari 0.65 */
  transform-origin: center center;
  margin: 0 auto;
  min-height: auto;
  gap: 10px;
  padding: 4px 0;
}

.electric-flow .irkop-flow-node {
  min-height: 90px;
  padding: 12px 10px;
  border-radius: 14px;
  border-width: 2px;
  border-color: rgba(139, 92, 246, 0.3);
  transition: all 0.3s ease;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(4px);
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.08);
}

.electric-flow .irkop-flow-node:hover {
  transform: translateY(-5px) scale(1.04);
  border-color: rgba(139, 92, 246, 0.9);
  box-shadow: 0 0 40px rgba(139, 92, 246, 0.25), 0 0 80px rgba(139, 92, 246, 0.1);
}

/* Ikon */
.electric-icon {
  width: 42px;
  height: 42px;
  font-size: 22px;
  border-radius: 10px;
  margin-bottom: 4px;
  box-shadow: 0 0 25px rgba(139, 92, 246, 0.4);
  transition: box-shadow 0.4s ease;
}

.electric-flow .irkop-flow-title {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: white;
}

.electric-flow .irkop-flow-subtitle {
  font-size: 9px;
  opacity: 0.7;
  color: rgba(255,255,255,0.7);
  margin-top: 2px;
}

/* Garis listrik */
.electric-link {
  position: relative;
  height: 4px;
  min-width: 30px;
  border-radius: 99px;
  background: rgba(139, 92, 246, 0.3);
  overflow: visible;
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.25);
}

.electric-link::before {
  content: "";
  position: absolute;
  inset: 0;
  width: 35%;
  border-radius: inherit;
  background: linear-gradient(
    90deg,
    transparent,
    #a78bfa,
    #22d3ee,
    #a78bfa,
    transparent
  );
  background-size: 300% 100%;
  filter: blur(1px);
  animation: electricArc 1.2s linear infinite;
  box-shadow: 0 0 30px rgba(167, 139, 250, 0.7);
}

.electric-link::after {
  content: "";
  position: absolute;
  left: -4px;
  top: 50%;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  transform: translateY(-50%);
  background: #c4b5fd;
  box-shadow: 0 0 30px #8b5cf6, 0 0 60px rgba(139, 92, 246, 0.9);
  animation: electricParticle 1.2s linear infinite;
}

/* Percikan */
.spark {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #c4b5fd;
  box-shadow: 0 0 30px #8b5cf6, 0 0 60px rgba(139, 92, 246, 0.6);
  pointer-events: none;
  opacity: 0;
}

.spark-1 {
  top: 25%;
  left: 25%;
  animation: sparkle 1.8s ease-in-out infinite 0.2s;
}

.spark-2 {
  top: 70%;
  left: 50%;
  animation: sparkle 2.2s ease-in-out infinite 0.7s;
}

.spark-3 {
  top: 35%;
  left: 75%;
  animation: sparkle 1.6s ease-in-out infinite 1.2s;
}

/* Pulse */
.electric-pulse {
  inset: 5%;
  filter: blur(25px);
  background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 65%);
  animation: electricPulse 2.8s ease-in-out infinite;
}

/* Keyframes tetap sama */
@keyframes electricArc {
  0% { background-position: -300% 0; }
  100% { background-position: 300% 0; }
}

@keyframes electricParticle {
  0% { left: -8px; opacity: 0; transform: translateY(-50%) scale(0.5); }
  10% { opacity: 1; transform: translateY(-50%) scale(1.3); }
  90% { opacity: 1; transform: translateY(-50%) scale(1); }
  100% { left: calc(100% + 8px); opacity: 0; transform: translateY(-50%) scale(0.5); }
}

@keyframes sparkle {
  0%, 100% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 1; transform: scale(2); box-shadow: 0 0 50px #a78bfa, 0 0 100px rgba(139, 92, 246, 0.7); }
}

@keyframes electricPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.3); filter: blur(35px); }
}

/* Responsif */
@media (max-width: 720px) {
  .electric-flow .irkop-flow {
    transform: scale(0.65) !important;
  }
  .spark {
    display: none;
  }
}
