.irkop-flow-link {
  flex: 1;
  height: 3px;
  min-width: 20px;
  border-radius: 99px;
  background: rgba(139, 92, 246, 0.2);
  position: relative;
  overflow: visible;
}

.irkop-flow-link::before {
  content: "";
  position: absolute;
  inset: 0;
  width: 30%;
  border-radius: inherit;
  background: linear-gradient(90deg, transparent, #a78bfa, #22d3ee, #a78bfa, transparent);
  background-size: 300% 100%;
  animation: flowArc 1.4s linear infinite;
  box-shadow: 0 0 18px rgba(167, 139, 250, 0.5);
}

.irkop-flow-link::after {
  content: "";
  position: absolute;
  left: -4px;
  top: 50%;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #c4b5fd;
  transform: translateY(-50%);
  box-shadow: 0 0 24px #8b5cf6, 0 0 48px rgba(139, 92, 246, 0.6);
  animation: flowParticle 1.4s linear infinite;
}

.irkop-flow-pulse {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.07), transparent 70%);
  filter: blur(24px);
  animation: flowPulse 3s ease-in-out infinite;
  border-radius: 50%;
}

@keyframes flowArc {
  0% { background-position: -300% 0; }
  100% { background-position: 300% 0; }
}

@keyframes flowParticle {
  0% { left: -6px; opacity: 0; transform: translateY(-50%) scale(0.5); }
  10% { opacity: 1; transform: translateY(-50%) scale(1.3); }
  90% { opacity: 1; transform: translateY(-50%) scale(1); }
  100% { left: calc(100% + 6px); opacity: 0; transform: translateY(-50%) scale(0.5); }
}

@keyframes flowPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

/* Mode kecil untuk About */
.flow-visual-small .irkop-flow {
