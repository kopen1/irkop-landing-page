  .irkop-flow-link::before {
    width: 100%;
    height: 40%;
    animation: flowArcVertical 1.4s linear infinite;
  }
  @keyframes flowArcVertical {
    0% { background-position: 0 -300%; }
    100% { background-position: 0 300%; }
  }
  @keyframes flowParticleVertical {
    0% { top: -6px; opacity: 0; transform: translateX(-50%) scale(0.5); }
